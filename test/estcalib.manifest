# est_calib pins — REAL tokenizer counts of ripwire's output on test/estcalibfix.
# label o200k cl100k est_at_pin_time argv...   (space-separated; no argv may contain a space; a leading NAME=VALUE is env)
# Regenerate: python3 bench/tokenaudit/pin.py --bin build/ripwire   (needs tiktoken)
# Read by: test/tokenbudgetcheck.sh #18 — the calibration band. See bench/tokenaudit/README.md.
map 1009 999 1123 
map-topk5 538 535 653 --top-k=5
metrics 2381 2370 2509 --metrics
pack-signatures 1801 1784 2116 --pack-signatures
expand 541 542 455 --expand=billableTotal
# for-named re-pinned 2026-10-07: its --for rows now carry e= (+237 B, +64 o200k over its twin);
# for-named-noe is its e=-free twin (RIPWIRE_FOR_ENDLINES=never, byte-identical to the pre-e= answer). Other rows: 2026-09-12 pins.
# for-named / for-named-noe re-pinned 2026-10-15 (forbudget-soft round C, FOLD C: the <tail> carries page 0 of the file page;
# 962->1031 / 898->967 o200k, measured with pin.py; the twins still differ by exactly the e= rows, 64 o200k).
# for-named / for-named-noe re-pinned 2026-10-22 (lane mf1-nx: billableTotal is ONE function on the name-exact route, so the answer
# carries the caller hop <callers> and its legend clause; 1031->1257 / 967->1193 o200k, measured with pin.py; the twins still
# differ by exactly the e= rows, 64 o200k). Other rows kept (pin.py re-measured them within 1-8% of their pins).
for-named 1257 1250 1700 --for=billableTotal
for-named-noe 1193 1185 1605 RIPWIRE_FOR_ENDLINES=never --for=billableTotal
# for-named-nohop (mf1-nx fix round 1, rule 4 twin): RIPWIRE_NO_CALLER_HOP=1 keeps the pre-hop answer priced at its old pin (1031 o200k),
# so the path the hop switches off stays pinned beside the one it moved.
for-named-nohop 1031 1026 1392 RIPWIRE_NO_CALLER_HOP=1 --for=billableTotal
# for-budgeted re-pinned 2026-10-14 (forbudget-soft: an explicit budget is a soft row target — the header is no longer shed to fit, measured with pin.py; other rows kept).
# …and 2026-10-15 (round C: reserve sections first — the tail keeps its share and carries page rows with sym=; 855->982 o200k).
for-budgeted 982 974 1376 --for=dedupe --token-budget=400
pack-task 882 862 1104 --pack-task=dedupe
