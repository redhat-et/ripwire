   "source": ["# Spectral clustering design\n", "Compute the Fiedler vector of the Laplacian for graph bisection.\n"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["def fiedler_vector(laplacian):\n", "    # second-smallest eigenvector\n", "    return eigsh(laplacian, k=2, which='SM')\n"]
  }
 ],
