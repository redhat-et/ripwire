+// ---- R1: anchor-hop expansion (LARGER-style; DEFAULT on the conceptual --for route) ------------------
+// PLAN_audit5Public2026 "Hard parts — R1 anchor-hop expansion design" — implemented as decided there.
+// Different beast from anchoredLexicalRank above (--anchor, the EXPERIMENTAL PPR blend): this is a
+// bounded, transparent ONE-hop propagation, not a random walk, and it ships ON by default for the
+// conceptual (subtoken+body) route only — the name-exact route and --no-route stay byte-identical.
+//
+// Mechanics (all decided): the top-m anchors of the base BM25 rank each propagate α·anchorScore·ω(edge)
+// to their 1-hop call / import / decl-use neighbours; ω = 1/(1+ambOut) at the edge's CALL SITE (the
+// resolver-confidence honesty counter — a site whose calls the resolver had to guess propagates less);
+// candidates below θ of the largest propagated mass are dropped (θ-filter); total additions are capped
+// at 2m to bound token cost; the union is re-ranked (out = lex + propagated mass) and the downstream
+// budget cut is unchanged. α and θ are TRAIN-split-calibrated constants (bench/locbench/
+// anchorhop_calib.json records the sweep); the env overrides below exist ONLY for that calibration
+// sweep and the ablation gate — they are not a user surface.
+//
+// Determinism: anchors picked by (score desc, id asc); propagation iterates anchors in that order, CSR
+// rows in storage order, references in ingest order — single-threaded float adds in a fixed order.
+// Decl-use/import edges resolve conservatively: a use-site name must have exactly ONE langCompatible
+// in-corpus def to propagate (an ambiguous name-spray never manufactures hop mass).
+namespace anchorhopcfg
+{
+    // m: top-m base-rank anchors seed the hop (decided: 10 — tighter than --anchor's 20; one hop from a
+    // wrong anchor costs more than teleport mass does, so the seed set stays small).
+    inline constexpr std::size_t kHopAnchorCount = 10;
+    // cap: at most 2m candidates ever receive hop mass (bounds new entrants ⇒ bounds token cost).
+    inline constexpr std::size_t kHopMaxAdditionCount = 2 * kHopAnchorCount;
+    // α, θ — C++-TRAIN-calibrated 2026-07-23 (R1-cpp: cppbench SFML n=115, commit-message queries; the
+    // full sweep is bench/locbench/results/r1cpp_anchorhop/anchorhop_calib_cpp.json; the earlier PYTHON
+    // train sweep — plateau at α∈[0.05,0.15], decline above — is bench/locbench/anchorhop_calib.json).
+    // α scales anchor score into hop mass; θ drops candidates below θ×(max propagated mass). The C++
+    // surface is very different from Python's: strict@10 delta rises to a clean interior maximum at
+    // α=0.40 (+3.48pp; +2.61 across [0.05,0.30], +2.61 @ 0.5, +0.87 @ 0.6, −0.87 @ 0.8) with NO @1/MRR
+    // damage anywhere below 0.8 (MRR +0.01..+0.04 — call-graph evidence is denser and cleaner in C++
+    // than in Python, the recorded R1-cpp premise). θ ties on strict@10 (0.25/0.50/0.75 all +3.48);
+    // 0.75 wins the pre-registered @1/MRR tiebreak (+0.87pp @1, MRR +0.0023 over the lower θs).
+    inline constexpr float kHopAlpha = 0.40f;
+    inline constexpr float kHopTheta = 0.75f;
+}
+
+struct AnchorHopInfo
+{
+    std::uint32_t anchorCount   = 0;   // anchors that actually seeded (≤ kHopAnchorCount, positive-score only)
+    std::uint32_t liftedCount   = 0;   // candidates that received hop mass after θ-filter + cap
+    std::uint32_t newCount      = 0;   // of those, how many had ZERO base lexical score (truly hop-only finds)
+};
+
+// calibration-sweep-only env override: a non-negative float in `name`, else `fallback`. NOT a user surface.
+inline float anchorHopEnvOverride( const char* name, float fallback ) noexcept
+{
+    const char* e = std::getenv( name );
+    if( !e || !*e ) return fallback;
+    char*       end = nullptr;
+    const float v   = std::strtof( e, &end );
+    return ( end != e && v >= 0.f && v == v ) ? v : fallback;
+}
+
+inline std::vector<float> anchorHopExpandedRank( const IngestResult& ing, const Graph& g,
+                                                 const std::vector<float>& lex, AnchorHopInfo* info = nullptr,
+                                                 const LexRescorer* rescorer = nullptr )
+{
+    const std::size_t N = lex.size();
+    if( N == 0 || N != ing.symbols.size() || g.outOff.size() != N + 1 ) return lex;
+    if( std::getenv( "CTXPACK_NO_ANCHORHOP" ) ) return lex;               // ablation escape hatch (gate + evals)
+
+    const float alpha = anchorHopEnvOverride( "CTXPACK_ANCHORHOP_ALPHA", anchorhopcfg::kHopAlpha );
+    const float theta = anchorHopEnvOverride( "CTXPACK_ANCHORHOP_THETA", anchorhopcfg::kHopTheta );
+
+    // ── 1) top-m anchors by (lex desc, id asc), positive scores only — same shape as anchoredLexicalRank
+    std::vector<NodeId> anchorIds( N );
+    for( NodeId i = 0; i < N; ++i ) anchorIds[i] = NodeId( i );
+    const std::size_t anchorCount = std::min( anchorhopcfg::kHopAnchorCount, N );
+    std::partial_sort( anchorIds.begin(), anchorIds.begin() + anchorCount, anchorIds.end(),
+                       [ & ]( NodeId a, NodeId b ) { return lex[a] != lex[b] ? lex[a] > lex[b] : a < b; } );
+    anchorIds.resize( anchorCount );
+    while( !anchorIds.empty() && !( lex[ anchorIds.back() ] > 0.f ) ) anchorIds.pop_back();
+    if( anchorIds.empty() ) return lex;                                   // no lexical signal → expansion is a no-op
+
+    std::vector<char> isAnchor( N, 0 );
+    for( NodeId a : anchorIds ) isAnchor[a] = 1;
+
+    // ω at a call site: the resolver-confidence discount — 1/(1+ambOut[site]).
+    const bool haveAmb = g.ambOut.size() == N;
+    const auto siteOmega = [ & ]( NodeId site ) noexcept
+    { return 1.0f / ( 1.0f + float( haveAmb ? g.ambOut[ site ] : 0u ) ); };
+
+    // ── 2) propagate α·anchorScore·ω over 1-hop CALL edges (both directions of the resolved CSR).
+    //      Anchors never receive mass (they are the evidence source, not an "addition"); self-loops skipped.
+    //      COMBINATION RULE = MAX over supporting edges, not SUM (calibration finding, train split
+    //      2026-07-22): summing lets a hub symbol shared by many anchors (a utility helper, an
+    //      __init__ import target) accumulate several anchors' worth of mass and OUTRANK the true top
+    //      lexical hits — measured strict@1 27.1%→8.2% on train with sum at α=0.2. Max bounds any
+    //      candidate at α·topAnchorScore (α<1 ⇒ a hop-only candidate can never displace the #1 hit)
+    //      and scores a neighbour by its single BEST evidence edge. Deterministic either way; max is
+    //      also order-independent, so accumulation order cannot matter at all.
+    std::vector<float> hopMass( N, 0.f );
+    const auto  bump = [ & ]( NodeId c, float m ) { if( m > hopMass[c] ) hopMass[c] = m; };
+    const auto* inRo = g.inEdges.rowOffsets();
+    const auto* inCi = g.inEdges.colIndices();
+    for( NodeId a : anchorIds )
+    {
+        // callees of the anchor — the call site is the anchor itself
+        const float outContrib = alpha * lex[a] * siteOmega( a );
+        for( std::uint32_t k = g.outOff[a]; k < g.outOff[ a + 1 ]; ++k )
+        {
+            const NodeId c = g.outTargets[k];
+            if( c < N && c != a && !isAnchor[c] ) bump( c, outContrib );
+        }
+        // callers of the anchor — the call site is the CALLER (its resolver confidence discounts the edge)
+        for( std::uint32_t k = inRo[a]; k < inRo[ a + 1 ]; ++k )
+        {
+            const NodeId c = inCi[k];
+            if( c < N && c != a && !isAnchor[c] ) bump( c, alpha * lex[a] * siteOmega( c ) );
+        }
+    }
+
+    // ── 3) decl-use / import 1-hop neighbours (query-time only — these roles never enter the call CSR).
+    //      Conservative resolution: the use-site name must map to exactly ONE langCompatible in-corpus def.
+    {
+        // name → def-ids map, built once per query (the CSR has no read/write/import edges to reuse)
+        HashMap<std::string_view, ctx::svector<NodeId, 2>> defsByName;
+        defsByName.reserve( N );
+        for( const Symbol& s : ing.symbols ) defsByName[ std::string_view( s.name ) ].push_back( s.id );
+
+        for( const Reference& r : ing.references )
+        {
+            if( r.fromSymbol == kNoNode || r.fromSymbol >= N ) continue;
+            if( r.isInherit || r.isDocLink || r.isCompose ) continue;
+            if( r.role != RefRole::Read && r.role != RefRole::Write && r.role != RefRole::Import ) continue;
+            const bool fromIsAnchor = isAnchor[ r.fromSymbol ] != 0;
+            const auto it = defsByName.find( std::string_view( r.calleeName ) );
+            if( it == defsByName.end() ) continue;
+
+            // exactly one langCompatible def, else the site is ambiguous → no hop mass (honesty over recall)
+            NodeId target = kNoNode;
+            for( NodeId d : it->second )
+            {
+                if( d == r.fromSymbol || !langCompatible( ing.symbols[d].lang, r.lang ) ) continue;
+                if( target != kNoNode ) { target = kNoNode; break; }
+                target = d;
+            }
+            if( target == kNoNode ) continue;
+
+            const float omega = siteOmega( r.fromSymbol );                // the use site IS the "call site" here
+            if( fromIsAnchor && !isAnchor[ target ] )                     // anchor uses/imports the neighbour
+                bump( target, alpha * lex[ r.fromSymbol ] * omega );
+            else if( !fromIsAnchor && isAnchor[ target ] )                // the neighbour uses/imports an anchor
+                bump( r.fromSymbol, alpha * lex[ target ] * omega );
+        }
+    }
+
+    // ── 4) θ-filter at θ×maxMass, cap total additions at 2m (mass desc, id asc), re-rank the union
+    std::vector<NodeId> candidateIds;
+    float               maxMass = 0.f;
+    for( NodeId c = 0; c < N; ++c )
+        if( hopMass[c] > 0.f ) { candidateIds.push_back( c ); if( hopMass[c] > maxMass ) maxMass = hopMass[c]; }
+    if( candidateIds.empty() ) return lex;
+
+    const float cut = theta * maxMass;
+    candidateIds.erase( std::remove_if( candidateIds.begin(), candidateIds.end(),
+                        [ & ]( NodeId c ) { return hopMass[c] < cut; } ), candidateIds.end() );
+    if( candidateIds.size() > anchorhopcfg::kHopMaxAdditionCount )
+    {
+        std::partial_sort( candidateIds.begin(), candidateIds.begin() + anchorhopcfg::kHopMaxAdditionCount,
+                           candidateIds.end(),
+                           [ & ]( NodeId a, NodeId b ) { return hopMass[a] != hopMass[b] ? hopMass[a] > hopMass[b] : a < b; } );
+        candidateIds.resize( anchorhopcfg::kHopMaxAdditionCount );
+    }
+
+    // R1-cpp pruning restoration: under MaxScore pruning (K' >= m keeps the anchors exact) a surviving hop
+    // candidate's slot in `lex` can be a pruned 0 even though its true BM25 is positive — the capsule
+    // re-scores exactly those <=2m survivors from the retained integer stats (bit-identical floats to the
+    // exhaustive branch; gate test/anchorhopprunecheck.sh). Everything above this point reads only ANCHOR
+    // scores (exact by construction) and edge evidence, never a candidate's own lex slot. Without a
+    // capsule (exhaustive scoring, --adaptive/--anchor callers) `lex[c]` is already exact — same bytes.
+    std::vector<float> out = lex;
+    std::uint32_t      newCount = 0;
+    for( NodeId c : candidateIds )
+    {
+        const float exactLex = rescorer ? rescorer->rescore( ing, c ) : lex[c];
+        if( !( exactLex > 0.f ) ) ++newCount;
+        out[c] = exactLex + hopMass[c];
+    }
+    if( info )
+    {
+        info->anchorCount = std::uint32_t( anchorIds.size() );
+        info->liftedCount = std::uint32_t( candidateIds.size() );
+        info->newCount    = newCount;
+    }
+    return out;
+}
+
 // all symbols whose final-segment name matches `name` (overloads + same-name across files), in id
 // order — for --expand ("give me every def called X"), so nothing is silently missed.
 inline std::vector<NodeId> resolveAllByName( const IngestResult& ing, std::string_view name )
