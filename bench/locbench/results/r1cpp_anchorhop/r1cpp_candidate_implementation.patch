--- a/src/lexical.h
+++ b/src/lexical.h
@@ -66,6 +66,50 @@ inline void subtokens( std::string_view id, std::vector<std::string>& out )
 // has real, non-incidental lexical grounding somewhere in the corpus.
 inline constexpr float kWeakLexicalScoreThreshold = 1.0f;
 
+// ── R1-cpp: the top-m-anchor-restricted exact bound's rescoring capsule ──────────────────────────────
+// The anchor-hop expansion (graph.h anchorHopExpandedRank) is a full-distribution consumer only in ONE
+// narrow sense: the <=2m hop candidates that survive its θ-filter + cap need their EXACT BM25 base score
+// (a pruned 0 would corrupt `out = lex + hopMass` and the "lexically invisible" count). Everything else it
+// reads — the top-m anchors — is already exact under MaxScore pruning with K' >= m. So instead of
+// disabling pruning wholesale (R1's first landing: warm p95 +10.2% giveback on the LocBench release
+// protocol, the recorded root cause of its two-tier REJECT), lexicalScores can hand its integer BM25
+// statistics to the caller in this capsule, and the survivors are re-scored on demand: SAME expressions,
+// SAME evaluation order, SAME doubles → bit-identical floats to what the exhaustive branch would have
+// produced (gate: test/anchorhopprunecheck.sh byte-compares pruned vs CTXPACK_NO_PRUNE=1 under expansion).
+// The capsule is transient query state (alive only across the expansion call) — nothing here is cached.
